// Grammar for GRL (Grule Rule Language)

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ ("//" ~ (!"\n" ~ ANY)*) | ("/*" ~ (!"*/" ~ ANY)* ~ "*/") }

// Entry points
grl         = { SOI ~ rule_def* ~ EOI }

rule_def    = { kw_rule ~ ident ~ description? ~ salience? ~ "{" ~ kw_when ~ expr ~ kw_then ~ action* ~ "}" }
description = { string }
salience    = { kw_salience ~ int }

// Actions: an assignment or a function call. Whether the left-hand side is assignable
// (and the statement a call) is checked in parser.rs.
action    = { expr ~ (assign_op ~ expr)? ~ ";" }
assign_op = { "+=" | "-=" | "*=" | "/=" | "=" }

// Expressions: operator precedence is resolved by the Pratt parser in parser.rs
expr    = { operand ~ (infix ~ operand)* }
operand = _{ prefix* ~ primary ~ postfix* }
primary = _{ number | string | boolean | nil | call | ident | "(" ~ expr ~ ")" }

call = { ident ~ args }
args = { "(" ~ (expr ~ ("," ~ expr)*)? ~ ")" }

postfix = _{ method | field | index }
method  = { "." ~ ident ~ args }
field   = { "." ~ ident }
index   = { "[" ~ expr ~ "]" }

infix = _{ or | and | eq | ne | le | ge | lt | gt | add | sub | mul | div }
or    = { "||" }
and   = { "&&" }
eq    = { "==" }
ne    = { "!=" }
le    = { "<=" }
ge    = { ">=" }
lt    = { "<" }
gt    = { ">" }
add   = { "+" }
sub   = { "-" }
mul   = { "*" }
div   = { "/" }

prefix = _{ not | neg }
not    = { "!" }
neg    = { "-" }

// Literals
number  = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
int     = @{ "-"? ~ ASCII_DIGIT+ }
boolean = @{ (^"true" | ^"false") ~ !ident_char }
nil     = @{ ^"nil" ~ !ident_char }
string  = ${ "\"" ~ string_inner ~ "\"" }
string_inner = @{ (("\\" ~ ANY) | (!("\"" | "\\") ~ ANY))* }

// Identifiers
ident      = @{ !keyword ~ (ASCII_ALPHA | "_") ~ ident_char* }
ident_char = _{ ASCII_ALPHANUMERIC | "_" }

// Keywords are case-insensitive, as in Grule
keyword     = @{ (^"rule" | ^"when" | ^"then" | ^"salience" | ^"true" | ^"false" | ^"nil") ~ !ident_char }
kw_rule     = @{ ^"rule" ~ !ident_char }
kw_when     = @{ ^"when" ~ !ident_char }
kw_then     = @{ ^"then" ~ !ident_char }
kw_salience = @{ ^"salience" ~ !ident_char }
